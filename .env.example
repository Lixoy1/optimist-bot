TG_TOKEN=1234567890:реальный_telegram_token

GROQ_API_KEY=gsk_реальный_groq_key
# Groq shut down the old Llama IDs for Free/Developer on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Hotfix routing also uses these defaults when it detects stale model IDs.
OPTIMIST_GROQ_MODEL=openai/gpt-oss-120b
OPTIMIST_GROQ_FAST_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=реальный_gemini_key
GEMINI_MODEL=gemini-2.5-flash
OPTIMIST_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

OPENROUTER_API_KEY=sk-or-v1-реальный_openrouter_key
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1-0528:free
OPTIMIST_OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1-0528:free

# Set to 1 only if you intentionally need legacy model IDs on a plan where they still work.
OPTIMIST_ALLOW_LEGACY_MODELS=0

# Smart normal replies
SMART_CONTEXT_MAX_MESSAGES=40
SMART_CONTEXT_MAX_CHARS=16000
AI_RESPONSE_TEMPERATURE=0.62

# Images: runtime tries configured providers in this order:
# Pixazo -> Gemini -> Hugging Face -> Pollinations -> AI Horde
IMAGE_PROVIDER=pixazo,gemini,huggingface,pollinations
IMAGE_FALLBACK_PROVIDER=horde

PIXAZO_API_KEY=реальный_pixazo_key
PIXAZO_ENDPOINT=https://gateway.pixazo.ai/flux-2-klein-4b/v1/generateImage
PIXAZO_MODEL=flux-schnell

HF_TOKEN=hf_реальный_huggingface_token
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=hf-inference

# Current Pollinations API requires a key. The bot downloads image bytes
# server-side, so the key is never exposed to Telegram clients.
POLLINATIONS_API_KEY=реальный_pollinations_key
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux

AI_HORDE_API_KEY=0000000000
AI_HORDE_MODEL=stable_diffusion_xl

MORNING_TZ=Europe/Moscow
MORNING_HOUR=8
MENU_AUTO_TTL_SECONDS=120
SUMMARY_MAX_MESSAGES=3000
CONTEXT_MAX_MESSAGES=25
STICKERS_MAX_PER_CHAT=80
DEFAULT_STICKER_CHANCE=0.05
